      "fallbackExpression": "reset"
    },
    {
      "id": "F3A.TSU.D.WAIT_OPINION",
      "personality": 0,
      "text": "Puedo esperar. Aunque prefiero que no perdamos de vista por dónde seguir.",
      "emotion": "Concern",
      "intention": "accept_wait_and_voice_preference",
      "eventType": "FollowingChanged",
      "lifeState": "Active",
      "topic": "",
      "orderVariant": "opinion",
      "following": false,
      "group": "order.wait",
      "scope": "event_instance",
      "cooldown": 0,
      "priority": 80,
      "closure": "end_and_return_when_safe",
      "options": [],
      "preferredExpression": "sad_soft_if_validated",
      "fallbackExpression": "reset"
    },
    {
      "id": "F3A.TSU.E.DOWNED",
      "personality": 0,
      "text": "¡Ayúdame! No consigo levantarme.",
      "emotion": "Concern",
      "intention": "request_help_urgently",
      "eventType": "DownedEntered",
      "lifeState": "Downed",
      "topic": "",
      "orderVariant": "",
      "following": false,
