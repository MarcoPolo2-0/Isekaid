      "fallbackExpression": "reset"
    },
    {
      "id": "F3A.TSU.F.SAFE_RETURN",
      "personality": 0,
      "text": "Vaya. Hace un momento no podía ni incorporarme. Déjame recuperar el aliento antes de seguir.",
      "emotion": "Surprise",
      "intention": "name_recent_recovery",
      "eventType": "SafeReturnTalkRequested",
      "lifeState": "Active",
      "topic": "",
      "orderVariant": "",
