      "options": [],
      "preferredExpression": "reset",
      "fallbackExpression": "reset"
    },
    {
      "id": "F3A.TSU.D.WAIT_OPINION",
      "personality": 0,
      "text": "Puedo esperar. Aun así, prefiero que avancemos pronto; quiero dejar atrás este tramo.",
      "emotion": "Concern",
      "intention": "n1_tsu_d_wait_opinion",
      "eventType": "FollowingChanged",
      "lifeState": "Active",
      "topic": "",
      "orderVariant": "opinion",
      "following": false,
      "group": "order.wait",
      "scope": "event_instance",
      "cooldown": 0,
      "priority": 80,
      "closure": "end_and_return_when_safe",
      "options": [],
      "preferredExpression": "sad_soft_if_validated",
      "fallbackExpression": "reset"
    },
    {
      "id": "F3A.TSU.E.DOWNED",
      "personality": 0,
      "text": "¡Ayúdame! No consigo levantarme.",
      "emotion": "Concern",
      "intention": "request_help_urgently",
      "eventType": "DownedEntered",
      "lifeState": "Downed",
      "topic": "",
      "orderVariant": "",
      "following": false,
