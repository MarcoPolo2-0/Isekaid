    },
    {
      "id": "F3A.TSU.E.REVIVED",
      "personality": 0,
      "text": "Ah… Ya puedo moverme. Has vuelto a ayudarme. Gracias. Esa vez no iba a salir sola.",
      "emotion": "Relief",
      "intention": "thank_after_reanimation",
      "eventType": "ReanimationCompleted",
      "lifeState": "Active",
      "topic": "",
      "orderVariant": "",
      "following": false,
      "group": "F3A.TSU.E.REVIVED",
      "scope": "downed_episode",
