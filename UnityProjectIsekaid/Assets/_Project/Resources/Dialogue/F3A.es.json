    },
    {
      "id": "F3A.TSU.E.REVIVED",
      "personality": 0,
      "text": "Ya puedo moverme. No iba a salir sola de esa... Gracias. Quiero comprobar cómo me sostengo antes de seguir.",
      "emotion": "Relief",
      "intention": "n1_tsu_e_revived",
      "eventType": "ReanimationCompleted",
      "lifeState": "Active",
      "topic": "",
      "orderVariant": "",
      "following": false,
