    },
    {
      "id": "F3A.TSU.F.RESUME",
      "personality": 0,
      "text": "Lo que estábamos hablando puede esperar si hace falta. Si seguimos, empieza por donde lo dejamos.",
      "emotion": "Neutral",
      "intention": "offer_to_resume_without_repeating",
      "eventType": "ResumeConversationRequested",
      "lifeState": "Active",
      "topic": "",
