    {
      "id": "F3A.TSU.F.RESUME",
      "personality": 0,
      "text": "Podemos retomar lo de antes. Veamos dónde lo dejamos.",
      "emotion": "Neutral",
      "intention": "n1_tsu_f_resume",
      "eventType": "ResumeConversationRequested",
      "lifeState": "Active",
      "topic": "",
