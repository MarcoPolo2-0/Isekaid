  "entries": [
    {
      "id": "F3A.TSU.A.RESCUE",
      "personality": 0,
      "text": "Ya puedo sostenerme. Quería salir sola... no podía. Gracias por ayudarme.",
      "emotion": "Relief",
      "intention": "n1_tsu_a_rescue",
      "eventType": "FirstRescueCompleted",
      "lifeState": "Active",
      "topic": "",
      "orderVariant": "",
      "following": false,
      "group": "F3A.TSU.A.RESCUE",
      "scope": "encounter",
      "cooldown": 0,
      "priority": 70,
      "closure": "offer_topics_when_eligible",
      "options": [],
      "preferredExpression": "relaxed_if_validated",
      "fallbackExpression": "reset"
    },
    {
      "id": "F3A.TSU.B.TRAP.OPEN",
      "personality": 0,
      "text": "Pisé una cuerda y el lazo me levantó antes de que pudiera reaccionar. Menuda manera de recibir a quien pasa por aquí.",
      "emotion": "Concern",
      "intention": "answer_and_offer_choice",
      "eventType": "TopicSelected",
      "lifeState": "Active",
      "topic": "TRAP",
      "orderVariant": "",
      "following": false,
      "group": "F3A.TSU.B.TRAP.OPEN",
      "scope": "encounter",
      "cooldown": 0,
      "priority": 60,
      "closure": "await_player_choice",
      "options": [
        {
          "id": "F3A.TSU.B.TRAP.CHOICE.DETAIL",
          "text": "¿Viste quién la puso?",
          "target": "F3A.TSU.B.TRAP.DETAIL"
        },
        {
          "id": "F3A.TSU.B.TRAP.CHOICE.SPACE",
          "text": "No tienes que explicarlo ahora.",
          "target": "F3A.TSU.B.TRAP.SPACE"
        }
      ],
      "preferredExpression": "sad_soft_if_validated",
      "fallbackExpression": "reset"
    },
    {
      "id": "F3A.TSU.B.TRAP.DETAIL",
      "personality": 0,
      "text": "No vi a nadie. Eso es lo que más me fastidia: alguien la dejó preparada y se fue. No voy a quedarme debajo a comprobarlo.",
      "emotion": "Anger",
      "intention": "respond_without_creating_promise",
      "eventType": "PlayerOptionSelected",
      "lifeState": "Active",
      "topic": "TRAP",
      "orderVariant": "",
      "following": false,
      "group": "F3A.TSU.B.TRAP.DETAIL",
      "scope": "encounter",
      "cooldown": 0,
      "priority": 60,
      "closure": "complete_topic_and_return_to_topics",
      "options": [],
      "preferredExpression": "angry_soft_if_validated",
      "fallbackExpression": "reset"
    },
    {
      "id": "F3A.TSU.B.TRAP.SPACE",
      "personality": 0,
      "text": "Bien. Hay cosas más urgentes que escucharme protestar. Primero salgamos de junto a la cuerda.",
      "emotion": "Relief",
      "intention": "respect_silence",
      "eventType": "PlayerOptionSelected",
      "lifeState": "Active",
      "topic": "TRAP",
      "orderVariant": "",
      "following": false,
      "group": "F3A.TSU.B.TRAP.SPACE",
      "scope": "encounter",
      "cooldown": 0,
      "priority": 60,
      "closure": "complete_topic_and_return_to_topics",
      "options": [],
      "preferredExpression": "relaxed_if_validated",
      "fallbackExpression": "reset"
    },
    {
      "id": "F3A.TSU.B.FEEL.OPEN",
      "personality": 0,
      "text": "Puedo apoyar la pierna. Voy a probar despacio; si necesito parar, te lo diré. Lo de la cuerda todavía no quiero contarlo.",
      "emotion": "Concern",
      "intention": "n1_tsu_b_feel_open",
      "eventType": "TopicSelected",
      "lifeState": "Active",
      "topic": "FEEL",
      "orderVariant": "",
      "following": false,
      "group": "F3A.TSU.B.FEEL.OPEN",
      "scope": "encounter",
      "cooldown": 0,
      "priority": 60,
      "closure": "await_player_choice",
      "options": [
        {
          "id": "F3A.TSU.B.FEEL.CHOICE.BREATH",
          "text": "Puedes tomarte un momento.",
          "target": "F3A.TSU.B.FEEL.BREATH"
        },
        {
          "id": "F3A.TSU.B.FEEL.CHOICE.LATER",
          "text": "¿Prefieres que hablemos después?",
          "target": "F3A.TSU.B.FEEL.LATER"
        }
      ],
      "preferredExpression": "sad_soft_if_validated",
      "fallbackExpression": "reset"
    },
    {
      "id": "F3A.TSU.B.FEEL.BREATH",
      "personality": 0,
      "text": "Sí. Un momento, y vuelvo a intentarlo. Gracias por darme margen.",
      "emotion": "Relief",
      "intention": "regain_agency_b_feel_breath",
      "eventType": "PlayerOptionSelected",
      "lifeState": "Active",
      "topic": "FEEL",
      "orderVariant": "",
      "following": false,
      "group": "F3A.TSU.B.FEEL.BREATH",
      "scope": "encounter",
      "cooldown": 0,
      "priority": 60,
      "closure": "complete_topic_and_return_to_topics",
      "options": [],
      "preferredExpression": "relaxed_if_validated",
      "fallbackExpression": "reset"
    },
    {
      "id": "F3A.TSU.B.FEEL.LATER",
      "personality": 0,
      "text": "Después. Ahora quiero recuperar el pulso y saber si puedo seguir. De lo otro hablaré con más calma.",
      "emotion": "Neutral",
      "intention": "n1_tsu_b_feel_later",
      "eventType": "PlayerOptionSelected",
      "lifeState": "Active",
      "topic": "FEEL",
      "orderVariant": "",
      "following": false,
      "group": "F3A.TSU.B.FEEL.LATER",
      "scope": "encounter",
      "cooldown": 0,
      "priority": 60,
      "closure": "complete_topic_and_return_to_topics",
      "options": [],
      "preferredExpression": "reset",
      "fallbackExpression": "reset"
    },
    {
      "id": "F3A.TSU.B.ROAD.OPEN",
      "personality": 0,
      "text": "Iba hacia la aldea. Y pienso seguir; esta trampa no va a decidir mi camino.",
      "emotion": "Neutral",
      "intention": "answer_and_offer_choice",
      "eventType": "TopicSelected",
      "lifeState": "Active",
      "topic": "ROAD",
      "orderVariant": "",
      "following": false,
      "group": "F3A.TSU.B.ROAD.OPEN",
      "scope": "encounter",
      "cooldown": 0,
      "priority": 60,
      "closure": "await_player_choice",
      "options": [
        {
          "id": "F3A.TSU.B.ROAD.CHOICE.TOGETHER",
          "text": "Compartamos el camino hasta la aldea.",
          "target": "F3A.TSU.B.ROAD.TOGETHER"
        },
        {
          "id": "F3A.TSU.B.ROAD.CHOICE.UNCERTAIN",
          "text": "Aún no sé si me quedaré allí.",
          "target": "F3A.TSU.B.ROAD.UNCERTAIN"
        }
      ],
      "preferredExpression": "reset",
      "fallbackExpression": "reset"
    },
    {
      "id": "F3A.TSU.B.ROAD.TOGETHER",
      "personality": 0,
      "text": "Hasta la aldea, entonces. Nos cuidamos en el sendero; después cada cual decide.",
      "emotion": "Joy",
      "intention": "respond_without_creating_promise",
      "eventType": "PlayerOptionSelected",
      "lifeState": "Active",
      "topic": "ROAD",
      "orderVariant": "",
      "following": false,
      "group": "F3A.TSU.B.ROAD.TOGETHER",
      "scope": "encounter",
      "cooldown": 0,
      "priority": 60,
      "closure": "complete_topic_and_return_to_topics",
      "options": [],
      "preferredExpression": "happy",
      "fallbackExpression": "reset"
    },
    {
      "id": "F3A.TSU.B.ROAD.UNCERTAIN",
      "personality": 0,
      "text": "Yo sí quiero llegar a la aldea. Podemos compartir este tramo; lo que hagas después lo decides tú.",
      "emotion": "Neutral",
      "intention": "n1_tsu_b_road_uncertain",
      "eventType": "PlayerOptionSelected",
      "lifeState": "Active",
      "topic": "ROAD",
      "orderVariant": "",
      "following": false,
      "group": "F3A.TSU.B.ROAD.UNCERTAIN",
      "scope": "encounter",
      "cooldown": 0,
      "priority": 60,
      "closure": "complete_topic_and_return_to_topics",
      "options": [],
      "preferredExpression": "reset",
      "fallbackExpression": "reset"
    },
    {
      "id": "F3A.TSU.C.LATER_1",
      "personality": 0,
      "text": "Lo del lazo… gracias otra vez. Me sale mejor fijarme por dónde piso que hablar de estas cosas.",
      "emotion": "Neutral",
      "intention": "regain_agency_c_later_1",
      "eventType": "TalkRequested",
      "lifeState": "Active",
      "topic": "",
      "orderVariant": "",
      "following": false,
      "group": "casual.later",
      "scope": "encounter",
      "cooldown": 20,
      "priority": 30,
      "closure": "end_and_return_when_safe",
      "options": [],
      "preferredExpression": "reset",
      "fallbackExpression": "reset"
    },
    {
      "id": "F3A.TSU.C.LATER_2",
      "personality": 0,
      "text": "Este sendero debería servir para viajar. Da rabia que alguien lo convierta en esto.",
      "emotion": "Anger",
      "intention": "recall_or_comment_without_reward",
      "eventType": "TalkRequested",
      "lifeState": "Active",
      "topic": "",
      "orderVariant": "",
      "following": false,
      "group": "casual.later",
      "scope": "encounter",
      "cooldown": 20,
      "priority": 30,
      "closure": "end_and_return_when_safe",
      "options": [],
      "preferredExpression": "angry_soft_if_validated",
      "fallbackExpression": "reset"
    },
    {
      "id": "F3A.TSU.C.LATER_3",
      "personality": 0,
      "text": "Al menos preguntas antes de tirar de otra cuerda. Es un comienzo bastante bueno.",
      "emotion": "Joy",
      "intention": "recall_or_comment_without_reward",
      "eventType": "TalkRequested",
      "lifeState": "Active",
      "topic": "",
      "orderVariant": "",
      "following": false,
      "group": "casual.later",
      "scope": "encounter",
      "cooldown": 20,
      "priority": 30,
      "closure": "end_and_return_when_safe",
      "options": [],
      "preferredExpression": "happy",
      "fallbackExpression": "reset"
    },
    {
      "id": "F3A.TSU.D.FOLLOW",
      "personality": 0,
      "text": "Voy. Pero si ves otra cuerda, me avisas antes de acercarte.",
      "emotion": "Neutral",
      "intention": "accept_follow_with_opinion",
      "eventType": "FollowingChanged",
      "lifeState": "Active",
      "topic": "",
      "orderVariant": "",
      "following": true,
      "group": "F3A.TSU.D.FOLLOW",
      "scope": "event_instance",
      "cooldown": 0,
      "priority": 80,
      "closure": "end_and_return_when_safe",
      "options": [],
      "preferredExpression": "reset",
      "fallbackExpression": "reset"
    },
    {
      "id": "F3A.TSU.D.WAIT",
      "personality": 0,
      "text": "De acuerdo. Espero aquí.",
      "emotion": "Neutral",
      "intention": "n1_tsu_d_wait",
      "eventType": "FollowingChanged",
      "lifeState": "Active",
      "topic": "",
      "orderVariant": "plain",
      "following": false,
      "group": "F3A.TSU.D.WAIT",
      "scope": "event_instance",
      "cooldown": 0,
      "priority": 80,
